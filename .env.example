# Copy to .env (never commit .env). Everything works offline with the defaults.
APP_MODE=historical
LLM_MODE=fake                 # fake | live | replay
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUPS=        # optional, comma-separated backup keys (used when quota runs out)
GEMINI_MODEL_DEEP=gemini-4-argon
GEMINI_MODEL_FAST=gemini-4-argon # Argon everywhere (team decision); a Flash ID like gemini-3.8-flash is the fallback
EODHD_API_KEY=
FINNHUB_API_KEY=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
EDGAR_USER_AGENT="UclAgentVerse hackathon team <team-email>"
# Deploy (DigitalOcean droplet)
DOMAIN=localhost
PUBLIC_DEMO=0                 # 1 = public link: LLM_MODE defaults to replay unless set; passcode + rate limit on
DEMO_PASSCODE=
TASK_SECRET=
DAILY_LLM_BUDGET_USD=20
RATE_LIMIT_PER_MINUTE=30      # POSTs per visitor IP per minute (public demo only)
RECORDED_RUN=                # optional path to the finished historical SQLite run; read-only playback
